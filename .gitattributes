# OutsideTheBox Node Directory
# Git file handling rules

# Source code
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Service configuration
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf

# Images and binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf

# Never attempt text conversion on archives
*.zip binary
*.gz binary
*.tar binary

# Python bytecode is not source code
*.pyc binary
*.pyo binary
